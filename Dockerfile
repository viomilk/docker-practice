# 1. Беремо готову міні-версію Linux із вже встановленим Python
FROM python:3.9-slim

# 2. Створюємо робочу папку всередині контейнера
WORKDIR /app

# 3. Копіюємо наш index.html з твого комп'ютера всередину контейнера
COPY index.html .

# 4. Кажемо, що контейнер буде слухати порт 8000
EXPOSE 8000

# 5. Команда, яка запуститься при старті контейнера (запуск веб-сервера)
CMD ["python3", "-m", "http.server", "8000"]
